{
  "name": "tessera-api",
  "version": "0.1.0",
  "description": "Real-time ledger and settlement engine — API",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "pnpm run build:contracts && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build:contracts && jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "pnpm run build:contracts && jest --coverage --runInBand",
    "migrate": "node-pg-migrate -j sql -m migrations up",
    "migrate:down": "node-pg-migrate -j sql -m migrations down",
    "migrate:create": "node-pg-migrate -j sql -m migrations create",
    "db:up": "./scripts/db.sh up",
    "db:down": "./scripts/db.sh down",
    "db:status": "./scripts/db.sh status",
    "db:psql": "./scripts/db.sh psql",
    "db:reset": "./scripts/db.sh reset && pnpm migrate",
    "build:contracts": "pnpm --filter @tessera/contracts build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@tessera/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "kysely": "^0.28.7",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.3.0",
    "jest": "^30.1.1",
    "node-pg-migrate": "^8.0.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
