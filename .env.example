# ---- Server ----
# 3010 rather than 3000/3001, both of which are commonly already in use locally.
NODE_ENV=development
PORT=3010
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3011

# ---- Database ----
# Local dev cluster managed by ./scripts/db.sh (no Docker, no sudo).
# Port 5434 avoids colliding with anything on the default 5432.
DATABASE_URL=postgres://tessera@127.0.0.1:5434/tessera
DATABASE_POOL_MAX=10

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=2592000     # seconds (30d)

# ---- Ledger ----
# Starting virtual credit grant for a new account, in MINOR UNITS (100 = 1.00 credit).
SIGNUP_GRANT_MINOR=100000

# ---- Rate limiting ----
# Set to false ONLY for load testing. Refused outright when NODE_ENV=production.
THROTTLE_ENABLED=true

# ---- Logging ----
LOG_LEVEL=debug
